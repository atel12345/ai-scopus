{
  "name": "ai-scopus",
  "private": true,
  "scripts": {
    "start:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}